POLYMARKET_USER_ADDRESS=0xYourAddressHere
# For multiple wallets, use comma-separated addresses instead of the single-address variable.
# POLYMARKET_USER_ADDRESSES=0xAddressOne,0xAddressTwo
SERVERCHAN_SEND_KEY=SCT_YOUR_KEY_HERE
FTQQ_PUSH_KEY=sctp_YOUR_KEY_HERE
# APR 调仓阈值（单位：百分比）。低于此值的仓位会被单独提示。缺省为 8。
APR_THRESHOLD=8
# 「即将归零」市价阈值（0~1）。持有方向市价低于此值视为论点破裂、大概率归零，单独列出。缺省为 0.5。
LOSING_PRICE_THRESHOLD=0.5

# Vercel Cron 可选配置：通过 GitHub API 更新 data/portfolio-history.json。
GITHUB_REPOSITORY=owner/repository
GITHUB_HISTORY_BRANCH=main
# The Dashboard reads the public Raw URL; no GitHub token is required.

# PolyYield V1: shared by Vercel Cron routes; keep this server-side only.
CRON_SECRET=replace-with-a-long-random-secret
# V1 is read-only/dry-run. Live order execution is not implemented.
DRY_RUN=true
# JSON array; replace the placeholder values with a real market strategy before testing.
STRATEGIES_JSON=[{"name":"example-no","tokenId":"YOUR_TOKEN_ID","endTime":"2026-12-31T23:59:59Z","targetApy":0.20,"amountUsd":1000,"minExternalLevelUsd":500,"tickSize":0.001}]
