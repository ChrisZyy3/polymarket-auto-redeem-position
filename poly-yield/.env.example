# Protect /api/rebalance. Cloudflare should send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret

# Safe default. Keep true until logs match your expectations.
DRY_RUN=true

# Existing Polymarket trading wallet credentials.
# PRIVATE_KEY must never be exposed to NEXT_PUBLIC_* variables.
POLY_PRIVATE_KEY=0x...
POLY_FUNDER_ADDRESS=0x...
# 0 = EOA. Existing Polymarket accounts may use a different signature type.
POLY_SIGNATURE_TYPE=0

# Optional L2 API credentials. If omitted, the SDK derives them from the signer.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# JSON array. targetApy is decimal: 0.20 = 20% APY.
# amountUsd is max capital committed by this strategy.
STRATEGIES_JSON=[{"name":"example-no","tokenId":"YOUR_TOKEN_ID","endTime":"2026-12-31T23:59:59Z","targetApy":0.20,"amountUsd":1000,"minExternalLevelUsd":500,"tickSize":0.001,"negRisk":false,"minRepriceSeconds":300}]
